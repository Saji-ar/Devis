# Copiez ce fichier en .env et adaptez les chemins.

# Dossier racine des donnees (contient devis/ et templates/).
# Sur le Raspberry Pi, pointez vers le dossier OneDrive deja synchronise, par ex :
#   DATA_DIR=/home/pi/OneDrive/sarl ASD/Compta/Devis Traiteur
DATA_DIR=../data

# Sous-dossier (dans DATA_DIR) ou sont ranges les fichiers .xlsx des devis.
DEVIS_SUBDIR=devis

# Chemin du template .xlsx utilise pour generer les nouveaux devis.
TEMPLATE_PATH=../data/templates/template.xlsx

# Fichier SQLite (index/cache reconstruisible).
DATABASE_URL=sqlite:///./devis.db

# Dossier ou sont ecrits les PDF exportes. Vide = <DATA_DIR>/pdf.
PDF_DIR=

# Origines autorisees pour le front (CORS), separees par des virgules.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Securite ---
# Mot de passe d'acces (en clair). Vide = aucune protection.
APP_PASSWORD=changez-moi
# Nombre de tentatives ratees autorisees ; au-dela l'appli se bloque.
MAX_LOGIN_ATTEMPTS=10
# Interrupteur. Passe automatiquement a false apres trop d'echecs.
# Pour relancer l'appli apres un blocage : remettre a true puis redemarrer.
APP_ENABLED=true

# Dossier d'anciens .xlsx a importer via le bouton "Importer d'anciens devis".
# Laissez vide pour desactiver. Exemple :
# IMPORT_SOURCE_DIR=/Users/vous/Library/CloudStorage/OneDrive-Personnel/sarl ASD/Compta/Devis Traiteur
IMPORT_SOURCE_DIR=
