# Copiez ce fichier en deploy/.env sur le Raspberry Pi et adaptez.

# Dossier OneDrive (déjà synchronisé sur le Pi) qui contiendra templates/ et devis/.
# Exemple (à adapter au chemin réel sur le Pi) :
DEVIS_DATA_DIR=/home/pi/OneDrive/Devis/data

# Mot de passe d'accès à l'application (en clair).
APP_PASSWORD=changez-moi
